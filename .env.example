# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，禁止提交密钥
# ===================== 后端（backend/.env） =====================

# 运行环境：dev | test | prod
ENVIRONMENT=dev
LOG_LEVEL=INFO

# 数据库（PostgreSQL）
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_interview
DATABASE_ECHO=false

# 必填：令牌签名密钥（生产环境请使用足够长的随机值）
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=2592000

# Cookie 安全（生产环境请开启 secure）
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# 允许跨域访问的来源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173

# Argon2id 参数
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# 大模型（OpenAI 兼容接口，默认 DeepSeek）
# 不配置时其余功能可用，仅押题生成返回 MODEL_UNAVAILABLE
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=4096
PROMPT_VERSION=prediction-v1
PREDICTION_QUESTION_COUNT=8

# 文件上传
UPLOAD_ROOT=var/uploads
UPLOAD_MAX_SIZE_MB=10
RESUME_QUOTA_PER_USER=10
RESUME_MAX_CHARS=12000

# ===================== 前端（frontend/.env） =====================
# 后端接口地址
VITE_API_BASE_URL=http://localhost:8000/api/v1
